# Default sync config. To change it on one machine, copy this file to
# paths.env (gitignored) and edit it there; paths.env is loaded after this file.

# Optional nickname that goes in commit messages (e.g. "laptop"). Leave it empty to omit.
MACHINE_NAME=""

# Files to sync, one "repo-path:machine-path" per line.
FILES=(
  "zsh/.zshrc:$HOME/.zshrc"
  "claude/settings.json:$HOME/.claude/settings.json"
  "claude/statusline.py:$HOME/.claude/statusline.py"
  "npm/.npmrc:$HOME/.npmrc"
)
